name: API Shift-Right Monitoring

on:
  schedule:
    - cron: '0 * * * *' # Chạy tự động mỗi giờ
  workflow_dispatch: # Cho phép chạy thủ công

jobs:
  monitor:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Install Newman
        run: npm install -g newman

      - name: Run Hourly Monitor Test
        env:
          TOKEN: ${{ secrets.GOREST_TOKEN }}
        run: |
          newman run *.json -e *Env*.json --env-var "token=$TOKEN" -r cli
